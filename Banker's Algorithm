#include <stdio.h>
int main(){
 int a=3,max[]={3,2},al[]={1,1},need[2],i,ok=1;
 for(i=0;i<2;i++) 
        need[i]=max[i]-al[i];
 printf("Available: %d\n",a);
 for(i=0;i<2;i++) 
       if(need[i]<=a){
             a+=al[i];printf("T%d Approved\n",i+1);}
       else {ok=0;
             printf("T%d Delayed\n",i+1);}
 printf(ok?"System is SAFE\n":"System is UNSAFE\n");
}
