#include <stdio.h>
int id[20], ex[20], n=0, N;
void access(int i,int e){
    for(int k=0;k<n;k++) if(id[k]==i){ printf("Hit\n"); return; }
    printf("Fault "); if(n<N){ id[n]=i; ex[n]=e; n++; }
    else printf("Frame full - replacement needed");
    printf("\n");
}
int main(){ int r,i,e;
    printf("Enter number of frames: "); scanf("%d",&N);
    printf("Enter number of page requests: "); scanf("%d",&r);
    for(int k=0;k<r;k++){ scanf("%d %d",&i,&e); access(i,e);}} 
