#include <stdio.h>
int id[20], front=0, rear=0, cnt=0, N;
void enqueue(int p){ if(cnt==N){printf("Queue Full\n");return;} id[rear]=p; rear=(rear+1)%N; cnt++; }
void dequeue(){ printf("Treating patient %d\n",id[front]); front=(front+1)%N; cnt--; }
int main(){
    int n,i,p;
    printf("Enter queue size: "); scanf("%d",&N);
    printf("Enter number of patients: "); scanf("%d",&n);
    for(i=0;i<n;i++){ printf("Patient ID: "); scanf("%d",&p); enqueue(p); }
    while(cnt) dequeue();
    return 0;
}     
