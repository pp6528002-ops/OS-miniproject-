#include <stdio.stdio.h>
int main() {
    int pr[] = {2, 1, 3, 2}, bt[] = {5, 3, 8, 6}, wt[4] = {0}, tat[4], t = 0;
    for(int i = 0; i < 4; i++) for(int j = i + 1; j < 4; j++)
        if(pr[i] > pr[j]) {
            int x = pr[i]; pr[i] = pr[j]; pr[j] = x;
            x = bt[i]; bt[i] = bt[j]; bt[j] = x;
        }
    printf("Traffic Signal Priority Order:\n");
    for(int i = 0; i < 4; i++) {
        wt[i] = t; tat[i] = wt[i] + bt[i]; t += bt[i];
        printf("Lane %d Priority:%d GreenTime:%d WT:%d TAT:%d\n", i+1, pr[i], bt[i], wt[i], tat[i]);
    }
    printf("Avg WT=%.1f\n", (wt[0] + wt[1] + wt[2] + wt[3]) / 4.0);
}
