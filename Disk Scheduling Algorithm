#include <stdio.h>
#include <stdlib.h>
int main() { int n, h, D, q[20], U[20] = {0}, i, j, k, m, p, lo = 999,
    hi = 0, b = 0, f = 0, s = 0;
    printf("No. of requests: "); scanf("%d", &n); printf("Request: ");
    for (i = 0; i < n; i++) scanf("%d", &q[i]);
    printf("Head: "); scanf("%d", &h); printf("Disk size: ");
    scanf("%d", &D);
    for (i = 0; i < n; i++) { if (q[i] < lo) lo = q[i]; if (q[i] > hi) hi = q[i];
        if (q[i] < h && q[i] > b) b = q[i]; f += abs(q[i] - (i ? q[i-1] : h)); }
    for (p = h, k = 0; k < n; k++) { for (m = -1, j = 0; j < n; j++)
        if (!U[j] && (m < 0 || abs(q[j] - p) < abs(q[m] - p)))
            m = j;
        U[m] = 1; s += abs(q[m] - p); p = q[m]; }
    printf("FCFS = %d\nSSTF = %d\n", f, s);
    printf("SCAN = %d\n", (D-1-h) + (D-1-lo));
    printf("C-SCAN = %d\n", (D-1-h) + (D-1) + b);
    printf("Look = %d\n", (hi-h) + (hi-lo));}
