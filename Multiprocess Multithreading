 #include<stdio.h>
#include<pthread.h>
#include<unistd.h>
void *airline (void *arg) {
      printf("Ticket Booked\n");
      printf("Seat Allocated\n");
      printf("Boarding Pass Generated\n");
      return NULL;}
int main () {
pthread_t t;
if (fork () == 0) {
   pthread_create (&t, NULL, airline, NULL);
   pthread_join (t, NULL);}
else {pthread_create (&t, NULL, airline, NULL);
        pthread_join (t, NULL);}
return 0;
}  
