#include <stdio.h>
#include <pthread.h>
void *book1(void *arg){
      for (int i=1;i<=3;i++)
        printf("Passenger 1seat %d Booked\n",i);}
void *book2(void *arg){
      for (int i=4;i<=6;i++)
        printf("Passenger 2seat %d Booked\n",i);}
int main(){
pthread_t t1,t2;
pthread_create (&t1,NULL,book1,NULL);
pthread_create (&t2,NULL,book2,NULL);
pthread_join(t1,NULL);
pthread_join(t2,NULL);
return 0;
}
