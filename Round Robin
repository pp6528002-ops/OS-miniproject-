#include <stdio.stdio.h>
int main() {
    int n = 4, bt[] = {5, 3, 8, 6}, rem[4], wt[4] = {0}, tat[4], tq = 2, t = 0, i, done;
    for (i = 0; i < n; i++) rem[i] = bt[i];
    while (1) {
        done = 1;
        for (i = 0; i < n; i++) {
            if (rem[i] > 0) {
                done = 0;
                if (rem[i] > tq) { t += tq; rem[i] -= tq; }
                else { t += rem[i]; wt[i] = t - bt[i]; rem[i] = 0; }
            }
        }
        if (done) break;
    }
    for (i = 0; i < n; i++) printf("Signal %d -> Green Time: %ds | Wait: %ds | TAT: %ds\n", i + 1, bt[i], wt[i], wt[i] + bt[i]);}
