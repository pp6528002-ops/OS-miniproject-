#include <stdio.h>
#include <string.h>
int main(){
    char u[30][20],f[30][20],a[20],b[20]; int n=0,i,j,d;
    for(;;){
        printf("Executive name (exit to stop): "); scanf("%s",a);
        if(!strcmp(a,"exit")) break;
        printf("File name: "); scanf("%s",b);
        for(d=0,i=0;i<n;i++) if(!strcmp(u[i],a)&&!strcmp(f[i],b)) d=1;
        if(d) printf("Error: '%s' already exists in %s's directory\n",b,a);
        else{ strcpy(u[n],a); strcpy(f[n++],b); printf("Created\n"); }
    }
    printf("\nMaster File Directory:\n");
    for(i=0;i<n;i++){ for(d=0,j=0;j<i;j++) if(!strcmp(u[j],u[i])) d=1; if(d) continue;
        printf("  %s/\n",u[i]); for(j=0;j<n;j++) if(!strcmp(u[j],u[i])) printf("      %s\n",f[j]);}
}
