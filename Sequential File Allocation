#include <stdio.h>
int main(){
    int used[50]={0},n,s,l,i,k,ok; char *f[]={"Exam Results","Lecture Recording","Mark Sheets"};
    printf("No. of files (max 3): "); scanf("%d",&n);
    for(k=0;k<n;k++){
        printf("%s - start block, length: ",f[k]); scanf("%d %d",&s,&l);
        for(ok=1,i=s;i<s+l;i++) if(i<0||i>=50||used[i]) ok=0;
        if(!ok){ printf("%s: blocks not free, not allocated\n",f[k]); continue; }
        printf("%s (start=%d, length=%d) -> blocks: ",f[k],s,l);
        for(i=s;i<s+l;i++){ used[i]=1; printf("%d ",i); }
        printf("\n");
    }
}   
